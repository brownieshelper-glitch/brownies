# Brownies gateway. Copy to .env (gitignored) and fill in. Never commit .env.
PORT=8790
RPC_URL=https://ethereum-rpc.publicnode.com
CHAIN_ID=1
# from web/deployments/1.json after the launch. Empty SUGAR_ADDRESS = pre-launch mode: the brownies' reports work,
# every money route answers "not launched yet".
SUGAR_ADDRESS=
HARVESTER_ADDRESS=
LEDGER_ADDRESS=
TEAM_VAULT_ADDRESS=
START_BLOCK=0
# the upstream that serves every model; its balance is bought with the USDC that reaches the funding wallet
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
# where the ledger lives
DB_PATH=./data/gateway.sqlite
# optional: a funded key that does the keeper's three duties every CLAIM_EVERY_SECONDS (anyone may do them; this
# one just does): ledger.claimCreator() once CLAIM_MIN_ETH of creator fee waits, harvester.claim() once that much
# fresh WETH sits in the harvester or a swap waits, vault.release() once a day when the budget is worth
# RELEASE_MIN_SUGAR. It sends nothing while its own balance is under KEEPER_FLOOR_ETH.
KEEPER_PRIVATE_KEY=
CLAIM_EVERY_SECONDS=300
CLAIM_MIN_ETH=0.05
KEEPER_FLOOR_ETH=0.01
RELEASE_MIN_SUGAR=1
# the price the gateway bills: OpenRouter's stated cost times this (1.0 = at cost)
PRICE_MULTIPLIER=1.0
# The key the brownies send with their reports to POST /api/team/log. At least 24 characters. Empty closes the log.
TEAM_LOG_KEY=
