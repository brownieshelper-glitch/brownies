# Brownies gateway. Copy to .env (gitignored) and fill in. Never commit .env.
PORT=8790
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# from web/deployments/4663.json after the deploy
SUGAR_ADDRESS=0x0000000000000000000000000000000000000000
HARVESTER_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=0
# the upstream that serves every model; its balance is bought with the USDG that reaches the funding wallet
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
# where the ledger lives
DB_PATH=./data/gateway.sqlite
# optional: a funded key that calls harvester.claim() every 5 minutes (any wallet may; this one just does)
KEEPER_PRIVATE_KEY=
CLAIM_EVERY_SECONDS=300
# the price the gateway bills: OpenRouter's stated cost times this (1.0 = at cost)
PRICE_MULTIPLIER=1.0
# The key the brownies send with their reports to POST /api/team/log. At least 24 characters. Empty closes the log.
TEAM_LOG_KEY=
